#!/usr/bin/env python3
"""Dry-run-first local client for the side-by-side canary gateway."""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from homelab_ops import client

client.REMOTE_GATEWAY = "/usr/local/sbin/homelab-ops-canary"


if __name__ == "__main__":
    raise SystemExit(client.main())
