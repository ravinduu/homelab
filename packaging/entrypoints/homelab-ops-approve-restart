#!/usr/bin/python3 -I
"""Installed-path compatibility entry point for administrator approvals."""

from __future__ import annotations

import stat
import sys
from pathlib import Path

INSTALLED_PATH = Path("/usr/local/sbin/homelab-ops-approve-restart")
PACKAGE_ROOT = Path("/usr/local/lib/homelab_ops")
PACKAGE_FILES = (
    "__init__.py",
    "approvals/__init__.py",
    "approvals/store.py",
    "gateway/__init__.py",
    "gateway/core.py",
    "gateway/approval_cli.py",
)


def validate_package_tree(package_root: Path, *, root_uid: int = 0, root_gid: int = 0) -> None:
    for relative in (".", "approvals", "gateway"):
        path = package_root if relative == "." else package_root / relative
        info = path.lstat()
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
            raise RuntimeError("unsafe package directory")
        if info.st_uid != root_uid or info.st_gid != root_gid or stat.S_IMODE(info.st_mode) != 0o755:
            raise RuntimeError("unsafe package directory")
    for relative in PACKAGE_FILES:
        path = package_root / relative
        info = path.lstat()
        if (stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode)
                or info.st_uid != root_uid or info.st_gid != root_gid
                or stat.S_IMODE(info.st_mode) != 0o640 or info.st_nlink != 1):
            raise RuntimeError("unsafe package module")


def validate_installed_package() -> None:
    if Path(__file__).absolute() != INSTALLED_PATH:
        return
    for component in reversed((PACKAGE_ROOT, *PACKAGE_ROOT.parents)):
        info = component.lstat()
        if (stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode)
                or info.st_uid != 0 or info.st_gid != 0 or info.st_mode & 0o022):
            raise RuntimeError("unsafe package path")
    validate_package_tree(PACKAGE_ROOT)
    sys.path.insert(0, "/usr/local/lib")


try:
    validate_installed_package()
except (OSError, RuntimeError):
    print("homelab-ops: executable ownership or mode check failed", file=sys.stderr)
    raise SystemExit(77)

if Path(__file__).absolute() != INSTALLED_PATH:
    sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from homelab_ops.gateway.approval_cli import main


if __name__ == "__main__":
    raise SystemExit(main())
